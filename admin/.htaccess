# ZEBIR LIBAS - Admin Console Production Security

# 1. Prevent Directory Listings
Options -Indexes

# 2. Block direct HTTP access to includes/ directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/.*$ - [F,L]

    # 1. Redirect GET requests from /admin/filename.php to /admin/filename (External Redirect)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \.php [NC]
    RewriteRule ^([^/.]+)\.php$ $1 [R=301,L]

    # 2. Rewrite /admin/filename to /admin/filename.php (Internal Rewrite)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>

# 3. HTTP Security Headers specifically for Admin Panel
<IfModule mod_headers.c>
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "same-origin"
</IfModule>
